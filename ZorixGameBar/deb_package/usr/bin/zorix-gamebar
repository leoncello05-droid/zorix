#!/usr/bin/env python3
import sys
import psutil
from PyQt5.QtWidgets import (QApplication, QWidget, QLabel, QPushButton, 
                             QVBoxLayout, QHBoxLayout, QComboBox, QFrame)
from PyQt5.QtCore import Qt, QTimer
from PyQt5.QtGui import QFont

class ZorixGameBar(QWidget):
    def __init__(self):
        super().__init__()
        self.initUI()
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.update_stats)
        self.timer.start(1000)

    def initUI(self):
        self.setWindowFlags(Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint | Qt.SubWindow)
        self.setAttribute(Qt.WA_TranslucentBackground, True)
        self.resize(550, 650)

        main_layout = QVBoxLayout()
        main_layout.setContentsMargins(15, 15, 15, 15)

        container = QFrame()
        container.setObjectName("GlassContainer")
        container.setStyleSheet("""
            QFrame#GlassContainer {
                background-color: rgba(20, 20, 30, 0.85);
                border: 1px solid rgba(255, 255, 255, 0.15);
                border-radius: 20px;
            }
            QLabel { color: #ffffff; font-family: 'Segoe UI', sans-serif; }
            QPushButton {
                background-color: rgba(255, 255, 255, 0.1);
                color: white;
                border: 1px solid rgba(255, 255, 255, 0.2);
                border-radius: 10px;
                padding: 10px;
                font-weight: bold;
            }
            QPushButton:hover {
                background-color: rgba(0, 180, 255, 0.3);
                border: 1px solid rgba(0, 180, 255, 0.6);
            }
            QComboBox {
                background-color: rgba(40, 40, 55, 0.9);
                color: white;
                border: 1px solid rgba(255, 255, 255, 0.2);
                border-radius: 8px;
                padding: 6px;
            }
        """)

        layout = QVBoxLayout(container)

        title = QLabel("ZORIX GAME BAR — LIQUID EDITION")
        title.setFont(QFont("Segoe UI", 14, QFont.Bold))
        title.setAlignment(Qt.AlignCenter)
        layout.addWidget(title)

        profile_layout = QHBoxLayout()
        profile_label = QLabel("Profilo Sistema:")
        self.profile_combo = QComboBox()
        self.profile_combo.addItems(["Potenza Massima (Ventole 100%)", "Normale / Bilanciato", "Risparmio Energetico"])
        profile_layout.addWidget(profile_label)
        profile_layout.addWidget(self.profile_combo)
        layout.addLayout(profile_layout)

        boost_layout = QHBoxLayout()
        self.btn_booster = QPushButton("⚡ GAME BOOSTER")
        self.btn_wine = QPushButton("🍷 WINE 3D RTX SETTINGS")
        
        self.btn_booster.clicked.connect(self.trigger_game_booster)
        self.btn_wine.clicked.connect(self.trigger_wine_booster)
        
        boost_layout.addWidget(self.btn_booster)
        boost_layout.addWidget(self.btn_wine)
        layout.addLayout(boost_layout)

        tm_title = QLabel("📊 Task Manager & Risorse")
        tm_title.setFont(QFont("Segoe UI", 11, QFont.Bold))
        layout.addWidget(tm_title)

        self.stats_label = QLabel("Caricamento statistiche...")
        self.stats_label.setStyleSheet("background: rgba(0,0,0,0.3); border-radius: 10px; padding: 10px; font-family: monospace;")
        layout.addWidget(self.stats_label)

        btn_close = QPushButton("Chiudi Overlay")
        btn_close.clicked.connect(self.close)
        layout.addWidget(btn_close)

        main_layout.addWidget(container)
        self.setLayout(main_layout)

    def update_stats(self):
        try:
            cpu = psutil.cpu_percent(interval=None)
            ram = psutil.virtual_memory()
            text = f"CPU Usage: {cpu}%\nRAM Used: {ram.percent}% ({ram.used // (1024**2)} MB / {ram.total // (1024**2)} MB)"
            self.stats_label.setText(text)
        except Exception:
            pass

    def trigger_game_booster(self):
        self.stats_label.setText("🚀 GAME BOOSTER ATTIVO: Priorità processi e RAM liberata!")

    def trigger_wine_booster(self):
        self.stats_label.setText("✨ WINE 3D RTX SETTINGS: Shader DXVK e DLSS/FSR attivati!")

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            self.oldPos = event.globalPos()

    def mouseMoveEvent(self, event):
        if event.buttons() == Qt.LeftButton:
            delta = event.globalPos() - self.oldPos
            self.move(self.x() + delta.x(), self.y() + delta.y())
            self.oldPos = event.globalPos()

if __name__ == '__main__':
    app = QApplication(sys.argv)
    ex = ZorixGameBar()
    ex.show()
    sys.exit(app.exec_())
